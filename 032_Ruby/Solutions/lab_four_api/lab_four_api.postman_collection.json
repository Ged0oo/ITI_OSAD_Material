                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Post has correct fields\", function () {",
                  "    pm.expect(jsonData.title).to.eql(\"Test Post\");",
                  "    pm.expect(jsonData.content).to.eql(\"This is a test post\");",
                  "    pm.expect(jsonData.user_id.toString()).to.eql(pm.collectionVariables.get(\"user_id\"));",
                  "});",
                  "pm.collectionVariables.set(\"post_id\", jsonData.id);"
