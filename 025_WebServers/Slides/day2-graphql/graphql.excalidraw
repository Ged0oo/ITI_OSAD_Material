      "updated": 1777192695600,
      "link": null,
      "locked": false,
      "text": "GraphQL is a query language designed as an alternative to the traditional REST\nAPI architecture",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GraphQL is a query language designed as an alternative to the traditional REST API architecture",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "f2cHdkeOjPMxJKozR9IWA",
      "type": "text",
      "x": 3882.0425597480826,
      "y": 667.9756002663214,
      "width": 794.2791748046875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 1399791256,
      "version": 95,
      "versionNonce": 687346920,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777192695600,
      "link": null,
      "locked": false,
      "text": "It gives developers more flexibility and control over how they fetch and mutate\ndata",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It gives developers more flexibility and control over how they fetch and mutate data",
      "autoResize": false,
      "lineHeight": 1.25
    },
