      "updated": 1777266391026,
      "link": null,
      "locked": false,
      "text": "Purpose: While typeDefs map out the graph, resolvers are \nthe actual JavaScript functions that fetch and return the data when a user makes a query\ntypeDefs (schema) → what is allowed\nresolvers → how the data is actually fetched",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Purpose: While typeDefs map out the graph, resolvers are \nthe actual JavaScript functions that fetch and return the data when a user makes a query\ntypeDefs (schema) → what is allowed\nresolvers → how the data is actually fetched",
      "autoResize": true,
      "lineHeight": 1.25
    },
