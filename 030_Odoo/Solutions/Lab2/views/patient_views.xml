<odoo>
    <record id="doctor_list" model="ir.ui.view">
        <field name="name">hms.doctor.list</field>
        <field name="model">hms.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="department_id"/>
                <field name="image"/>
            </list>
        </field>
    </record>

    <record id="doctor_form" model="ir.ui.view">
        <field name="name">hms.doctor.form</field>
        <field name="model">hms.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="first_name"/>
                        <field name="last_name"/>
                        <field name="department_id"/>
                        <field name="image" widget="image"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="doctor_action" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hms.doctor</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="department_list" model="ir.ui.view">
        <field name="name">hms.department.list</field>
        <field name="model">hms.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="capacity"/>
                <field name="state"/>
                <field name="patients"/>
            </list>
        </field>
    </record>

    <record id="department_form" model="ir.ui.view">
        <field name="name">hms.department.form</field>
        <field name="model">hms.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="capacity"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="department_action" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">hms.department</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="patient_list" model="ir.ui.view">
        <field name="name">hms.patient.list</field>
        <field name="model">hms.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="age"/>
                <field name="state"/>
                <field name="blood_type"/>
            </list>
        </field>
    </record>

    <record id="patient_form" model="ir.ui.view">
        <field name="name">hms.patient.form</field>
        <field name="model">hms.patient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Personal Information">
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="birth_date"/>
                            <field name="age" readonly="1"/>
                            <field name="state"/>
                            <field name="address"/>
                        </group>

                        <group string="Medical Information">
                            <field name="department_id" domain="[('state', '=', 'open')]"/>
                            <field name="department_capacity" readonly="1"/>
                            <field name="doctor_ids" widget="many2many_tags" readonly="not department_id"/>
                            <field name="blood_type"/>
                            <field name="pcr"/>
                            <field name="cr_ratio" required="pcr"/>
                        </group>

                        <group string="Profile Image">
                            <field name="image" widget="image"/>
                        </group>

                    </group>

                    <notebook>
                        <page string="Medical History">
                            <field name="history" invisible="age &lt; 50"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="patient_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hms.patient</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <menuitem id="hms_root" name="HMS"/>
    <menuitem id="hms_patient_menu" name="Patients" parent="hms_root" action="patient_action"/>
    <menuitem id="hms_doctor_menu" name="Doctors" parent="hms_root" action="doctor_action"/>
    <menuitem id="hms_department_menu" name="Departments" parent="hms_root" action="department_action"/>
</odoo>