<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hms_department_tree" model="ir.ui.view">
            <field name="name">hms.department.tree</field>
            <field name="model">hms.department</field>
            <field name="arch" type="xml">
                <list string="Departments">
                    <field name="name"/>
                    <field name="capacity"/>
                    <field name="is_opened"/>
                </list>
            </field>
        </record>


        <record id="view_hms_department_form" model="ir.ui.view">
            <field name="name">hms.department.form</field>
            <field name="model">hms.department</field>
            <field name="arch" type="xml">
                <form string="Department">
                    <sheet>
                        <group string="Department Information">
                            <field name="name"/>
                            <field name="capacity"/>
                            <field name="is_opened"/>
                        </group>
                        <notebook>
                            <page name="assigned_patients" string="Assigned Patients">
                                <field name="patient_ids" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hms_department" model="ir.actions.act_window">
            <field name="name">Departments</field>
            <field name="res_model">hms.department</field>
            <field name="view_mode">list,form</field>
        </record>


        <menuitem id="menu_hms_root" name="HMS" sequence="10"/>
        <menuitem id="menu_hms_department" name="Departments" parent="menu_hms_root" action="action_hms_department" sequence="20"/>
    </data>
</odoo>