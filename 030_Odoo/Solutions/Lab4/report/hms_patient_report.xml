<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_hms_patient_status_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Patient Status Report</h2>
                        <table style="width:100%; margin-bottom:20px;">
                            <tr>
                                <td style="width:75%; vertical-align:top;">

                                    <p><strong>Name:</strong>
                                        <span t-esc="('%s %s' % ((o.first_name or ''), (o.last_name or ''))).strip()"/>
                                    </p>

                                    <p><strong>Age:</strong>
                                        <span t-esc="o.age or 0"/>
                                    </p>

                                    <p><strong>Department:</strong>
                                        <span t-esc="o.department_id.name or '-'"/>
                                    </p>

                                    <p><strong>Doctors:</strong>
                                        <span t-esc="', '.join(['Dr. %s %s' % ((d.first_name or ''), (d.last_name or '')) for d in o.doctor_ids]) or '-'"/>
                                    </p>

                                    <p><strong>Birth Date:</strong>
                                        <span t-field="o.birth_date"/>
                                    </p>

                                    <p><strong>PCR:</strong>
                                        <span t-esc="o.cr_ratio if o.cr_ratio is not None else '-'"/>
                                    </p>

                                    <p><strong>Blood Type:</strong>
                                        <span t-esc="dict(o._fields['blood_type'].selection).get(o.blood_type) or '-'"/>
                                    </p>

                                    <p><strong>Email:</strong>
                                        <span t-esc="o.email or '-'"/>
                                    </p>

                                </td>

                                <td style="width:25%; text-align:right; vertical-align:top;">

                                    <t t-if="o.image">
                                        <img t-att-src="image_data_uri(o.image)" style="width:140px;height:140px;border:1px solid #ccc;padding:3px;object-fit:cover;"/>
                                    </t>

                                </td>
                            </tr>
                        </table>

                        <h3>Log History</h3>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr style="background-color:#f0f0ff;">
                                    <th>User</th>
                                    <th>Date</th>
                                    <th>Info</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-esc="o.create_uid.name or '-'"/></td>
                                    <td><span t-field="o.create_date" t-options="{'widget': 'datetime'}"/></td>
                                    <td>Record created</td>
                                </tr>
                                <tr>
                                    <td><span t-esc="o.write_uid.name or '-'"/></td>
                                    <td><span t-field="o.write_date" t-options="{'widget': 'datetime'}"/></td>
                                    <td>Last update</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_hms_patient_status" model="ir.actions.report">
        <field name="name">Patient Status Report</field>
        <field name="model">hms.patient</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hms.report_hms_patient_status_document</field>
        <field name="report_file">hms.report_hms_patient_status_document</field>
        <field name="binding_model_id" ref="model_hms_patient"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Patient Status - %s' % ((object.first_name or '') + ' ' + (object.last_name or '')).strip()</field>
    </record>
</odoo>
