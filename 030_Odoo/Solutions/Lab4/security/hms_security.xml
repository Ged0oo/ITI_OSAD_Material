<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_hms" model="ir.module.category">
            <field name="name">Hospital Management</field>
            <field name="description">Access levels for HMS users and managers.</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_hms_user" model="res.groups">
            <field name="name">HMS User</field>
            <field name="category_id" ref="hms.module_category_hms"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_hms_manager" model="res.groups">
            <field name="name">HMS Manager</field>
            <field name="category_id" ref="hms.module_category_hms"/>
            <field name="implied_ids" eval="[(4, ref('hms.group_hms_user'))]"/>
        </record>
    </data>
</odoo>
