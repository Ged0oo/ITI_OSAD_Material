<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hms_patient_user_own_rule" model="ir.rule">
            <field name="name">HMS Patients: user can access own records</field>
            <field name="model_id" ref="model_hms_patient"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('hms.group_hms_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hms_patient_user_create_rule" model="ir.rule">
            <field name="name">HMS Patients: user can create records</field>
            <field name="model_id" ref="model_hms_patient"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hms.group_hms_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hms_patient_manager_all_rule" model="ir.rule">
            <field name="name">HMS Patients: manager can access all records</field>
            <field name="model_id" ref="model_hms_patient"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hms.group_hms_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
