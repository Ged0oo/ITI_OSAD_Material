<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hms_patient_tree" model="ir.ui.view">
            <field name="name">hms.patient.tree</field>
            <field name="model">hms.patient</field>
                <field name="arch" type="xml">
                <list string="Patients">
                    <field name="first_name"/>
                    <field name="last_name"/>
                    <field name="age" readonly="1"/>
                    <field name="email"/>
                    <field name="department_id"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_hms_patient_form" model="ir.ui.view">
            <field name="name">hms.patient.form</field>
            <field name="model">hms.patient</field>
            <field name="arch" type="xml">
                <form string="Patient Record">
                    <header>
                        <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h1>
                                <field name="first_name" placeholder="First Name"/>
                                <field name="last_name" placeholder="Last Name" class="ms-2"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group string="Demographics">
                                <field name="birth_date"/>
                                <field name="age" readonly="1"/> <field name="email"/>
                                <field name="address"/>
                                <field name="blood_type"/>
                            </group>
                            <group string="Clinical Diagnostics">
                                <field name="pcr"/>
                                <field name="cr_ratio"/>
                                <field name="department_id"/>
                                <field name="department_capacity" readonly="1"/>
                                <field name="doctor_ids" widget="many2many_tags" groups="hms.group_hms_manager"/>
                            </group>
                        </group>

                        <notebook>
                            <page name="medical_history" string="Medical History">
                                <field name="history" placeholder="Enter clinical patient documentation logs..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hms_patient" model="ir.actions.act_window">
            <field name="name">Patients</field>
            <field name="res_model">hms.patient</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_hms_patient" name="Patients" parent="menu_hms_root" action="action_hms_patient" sequence="10"/>
    </data>
</odoo>